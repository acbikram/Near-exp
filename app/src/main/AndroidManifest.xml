<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Required on Android 13+ (API 33) to post notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets WorkManager reschedule the daily check after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 12+: permits an exact local 8:00 AM expiry alarm instead of
         a periodic background job that the system may defer by hours. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Lets the app prompt to be exempted from battery optimization, so the
         daily 8 AM expiry notification isn't delayed by aggressive OEM
         background restrictions (Honor/Huawei, Samsung, Xiaomi, etc.) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Lets the app update download run as a foreground service, so it keeps
         going (with a visible progress notification) even if the user leaves
         Settings or backgrounds the app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".NearExpiryApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NearExpiryManager"
        tools:targetApi="31">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.NearExpiryManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exact local-time delivery for the daily 8:00 AM expiry check. -->
        <receiver
            android:name=".notifications.DailyExpiryAlarmReceiver"
            android:exported="false" />

        <!-- Re-arms the exact local 8:00 AM schedule after reboot, timezone,
             date, or manually adjusted device-clock changes. -->
        <receiver
            android:name=".notifications.DailyExpiryScheduleRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Handles the "Remind me tomorrow" action on expiry notifications -->
        <receiver
            android:name=".notifications.SnoozeActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nearexpiry.manager.ACTION_SNOOZE_REMINDER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notifications.UpdateIgnoreReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nearexpiry.manager.ACTION_IGNORE_UPDATE" />
            </intent-filter>
        </receiver>

        <!-- Handles tapping "Install Now" on the download-complete notification;
             launches the system installer directly without needing the app UI open. -->
        <receiver
            android:name=".notifications.UpdateInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nearexpiry.manager.ACTION_INSTALL_UPDATE" />
            </intent-filter>
        </receiver>

        <!-- WorkManager's own foreground-service component, explicitly typed
             dataSync for the update-download progress notification (required
             on Android 14+ / API 34). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Lets AppCompatDelegate.setApplicationLocales(...) persist the
            chosen app language across restarts on API levels below 33,
            without requiring activities to extend AppCompatActivity.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            Disable WorkManager's default initializer so we can supply our own
            HiltWorkerFactory via Configuration.Provider in NearExpiryApplication.
            Without this, WorkManager initializes itself before Hilt is ready and
            the Hilt-injected worker constructor will crash.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
